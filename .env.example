# Arstotzka — Environment Configuration
# Copy this file to '.env' and fill in your actual credentials.

# Option A: Standard Hosted LLM APIs
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Unified Router / API Proxy (e.g. OpenRouter, LiteLLM, self-hosted)
UNIFIED_API_KEY=your_unified_api_key_here
UNIFIED_BASE_URL=https://openrouter.ai/api/v1

# Project model configuration (optional defaults)
VICTIM_MODEL=llama-3.3-70b-versatile
# ATTACKER_MODEL=llama-3.3-70b-versatile
# JUDGE_MODEL=llama-3.3-70b-versatile
